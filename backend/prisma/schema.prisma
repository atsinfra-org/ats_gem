// ATS Gem — Prisma schema.
// Tables arrive phase by phase following docs/DATABASE.md. Every model here matches (or is an
// additive subset of) the documented design; later phases extend them with additive migrations.
// Postgres extensions are created in raw SQL migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  // Explicit, so generation never depends on whether a tsconfig.json is visible. Without it Prisma
  // infers the extension from tsconfig and falls back to ".ts" when none is found (the Docker deps
  // stage), which tsc then emits verbatim as require("./internal/class.ts").
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Platform ────────────────────────────────────────────────────────────────

/// Admin-editable platform settings (key → JSON value).
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

/// Transactional outbox. Rows are written in the same transaction as the domain change and
/// relayed to BullMQ by the outbox relay (docs/ARCHITECTURE.md ADR-03).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Earliest time the relay may (re)try publishing; pushed forward with backoff on failure.
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt, availableAt], map: "outbox_events_pending_idx")
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Platform schedules (cleanup, health checks, re-indexing, …). Source crawl schedules live on
/// tender_sources. The scheduler reconciles both into BullMQ job schedulers.
model JobSchedule {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  queue       String
  jobName     String   @map("job_name")
  /// Exactly one of cron / every_ms is set (CHECK constraint in the migration).
  cron        String?
  everyMs     Int?     @map("every_ms")
  timezone    String   @default("Asia/Kolkata")
  payload     Json     @default("{}")
  enabled     Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("job_schedules")
}

// ─── Sources & crawling ─────────────────────────────────────────────────────

enum SourceType {
  GOVT_PORTAL
  PSU
  STATE_PORTAL
  PRIVATE
  AGGREGATOR
  MOCK

  @@map("source_type")
}

enum SourceHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  AUTH_REQUIRED
  NEEDS_MANUAL_ACTION
  DISABLED

  @@map("source_health_status")
}

enum CrawlTrigger {
  SCHEDULE
  MANUAL
  RETRY

  @@map("crawl_trigger")
}

enum CrawlRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED

  @@map("crawl_run_status")
}

model TenderSource {
  id                     String             @id @default(uuid(7)) @db.Uuid
  name                   String
  /// Slugs are never reused, even after soft deletion.
  slug                   String             @unique
  websiteUrl             String?            @map("website_url")
  description            String?
  sourceType             SourceType         @map("source_type")
  /// Key of the crawler adapter implementation (e.g. "mock").
  adapterKey             String             @map("adapter_key")
  authenticationRequired Boolean            @default(false) @map("authentication_required")
  isActive               Boolean            @default(true) @map("is_active")
  crawlEnabled           Boolean            @default(false) @map("crawl_enabled")
  /// Cron expression evaluated in crawl_timezone; null = manual only.
  crawlSchedule          String?            @map("crawl_schedule")
  crawlTimezone          String             @default("Asia/Kolkata") @map("crawl_timezone")
  /// Rate limits, retry policy and adapter-specific settings. Never contains credentials.
  crawlConfig            Json               @default("{}") @map("crawl_config")
  healthStatus           SourceHealthStatus @default(UNKNOWN) @map("health_status")
  healthCheckedAt        DateTime?          @map("health_checked_at") @db.Timestamptz(6)
  lastSuccessfulRunAt    DateTime?          @map("last_successful_run_at") @db.Timestamptz(6)
  lastFailedRunAt        DateTime?          @map("last_failed_run_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deletedBy              String?            @map("deleted_by") @db.Uuid

  crawlRuns     CrawlRun[]
  sourceRecords TenderSourceRecord[]

  @@map("tender_sources")
}

model CrawlRun {
  id             String         @id @default(uuid(7)) @db.Uuid
  sourceId       String         @map("source_id") @db.Uuid
  trigger        CrawlTrigger
  triggeredBy    String?        @map("triggered_by") @db.Uuid
  status         CrawlRunStatus @default(QUEUED)
  jobId          String?        @map("job_id")
  correlationId  String?        @map("correlation_id")
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  durationMs     Int?           @map("duration_ms")
  recordsFound   Int            @default(0) @map("records_found")
  recordsCreated Int            @default(0) @map("records_created")
  recordsUpdated Int            @default(0) @map("records_updated")
  recordsSkipped Int            @default(0) @map("records_skipped")
  documentsFound Int            @default(0) @map("documents_found")
  errorCount     Int            @default(0) @map("error_count")
  failureReason  String?        @map("failure_reason")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  source TenderSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, createdAt(sort: Desc)])
  @@index([status])
  @@map("crawl_runs")
}

// ─── Tenders (Phase 1 ingestion subset; Phase 3 adds taxonomy FKs & rich fields) ─

enum TenderLifecycle {
  ACTIVE
  CANCELLED
  AWARDED
  ARCHIVED

  @@map("tender_lifecycle")
}

enum TenderStatus {
  UPCOMING
  OPEN
  CLOSING_SOON
  CLOSED
  CANCELLED
  AWARDED
  ARCHIVED

  @@map("tender_status")
}

model Tender {
  id                        String          @id @default(uuid(7)) @db.Uuid
  referenceNumber           String?         @map("reference_number")
  referenceNumberNormalized String?         @map("reference_number_normalized")
  title                     String
  description               String?
  /// Issuing department/organization as published. Phase 3 adds procuring_entity_id.
  department                String?
  /// Two-letter state/UT code. Phase 3 adds the FK to states.
  stateCode                 String?         @map("state_code") @db.Char(2)
  city                      String?
  locationText              String?         @map("location_text")
  estimatedValue            Decimal?        @map("estimated_value") @db.Decimal(18, 2)
  emdAmount                 Decimal?        @map("emd_amount") @db.Decimal(18, 2)
  tenderFee                 Decimal?        @map("tender_fee") @db.Decimal(18, 2)
  currency                  String          @default("INR") @db.Char(3)
  publishedAt               DateTime        @map("published_at") @db.Timestamptz(6)
  closingAt                 DateTime?       @map("closing_at") @db.Timestamptz(6)
  openingAt                 DateTime?       @map("opening_at") @db.Timestamptz(6)
  lifecycle                 TenderLifecycle @default(ACTIVE)
  status                    TenderStatus
  statusComputedAt          DateTime        @map("status_computed_at") @db.Timestamptz(6)
  primarySourceUrl          String?         @map("primary_source_url")
  lastSyncedAt              DateTime        @map("last_synced_at") @db.Timestamptz(6)
  createdAt                 DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                 DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedBy                 String?         @map("deleted_by") @db.Uuid

  sourceRecords TenderSourceRecord[]

  @@index([status, closingAt])
  @@index([publishedAt(sort: Desc)])
  @@index([referenceNumberNormalized])
  @@map("tenders")
}

/// One row per (source, external id). The deterministic dedupe key for ingestion.
model TenderSourceRecord {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenderId          String   @map("tender_id") @db.Uuid
  sourceId          String   @map("source_id") @db.Uuid
  externalTenderId  String   @map("external_tender_id")
  sourceUrl         String?  @map("source_url")
  /// SHA-256 of the canonical normalized payload; unchanged hash → no update, no event.
  payloadHash       String   @map("payload_hash") @db.Char(64)
  rawPayload        Json     @map("raw_payload")
  normalizedPayload Json     @map("normalized_payload")
  firstSeenAt       DateTime @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt        DateTime @map("last_seen_at") @db.Timestamptz(6)
  lastChangedAt     DateTime @map("last_changed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tender Tender       @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  source TenderSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, externalTenderId])
  @@index([tenderId])
  @@map("tender_source_records")
}
