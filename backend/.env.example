# ─────────────────────────────────────────────────────────────
# ATS Gem backend — environment template.
# Copy to .env and fill in. Never commit real secrets.
# Variables marked (later) are declared now so deployments can be
# provisioned ahead of time; they become required in later phases.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
APP_NAME=ats-gem-api
PORT=4000
LOG_LEVEL=info
# LOG_FORMAT: json | pretty (default: pretty in development, json otherwise; pretty needs devDependencies)
LOG_FORMAT=
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
# Trust X-Forwarded-* headers from this many proxy hops (ALB/CloudFront = 1-2)
TRUST_PROXY_HOPS=0

# PostgreSQL
DATABASE_URL=postgresql://ats_gem:change-me@localhost:5432/ats_gem?schema=public
DATABASE_POOL_MAX=10

# Redis (BullMQ queues, cache, rate limits)
REDIS_URL=redis://localhost:6379/0

# Queues & background processing (Phase 1)
# BullMQ key prefix — isolates environments sharing one Redis
QUEUE_PREFIX=ats
# Worker: comma-separated queue names this process consumes ("*" = all).
# Queues: crawler.discovery, crawler.tender, document.processing, search.indexing,
#         notifications, email, maintenance   (dead-letter is never consumed)
WORKER_QUEUES=*
# How long a stopping worker waits for in-flight jobs before releasing them for retry
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Outbox relay (runs inside worker processes)
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION_DAYS=7
# Scheduler: how often job_schedules / source schedules are reconciled into BullMQ
SCHEDULER_SYNC_INTERVAL_MS=60000
# Health server port for worker / scheduler processes (defaults: worker 4001, scheduler 4002)
HEALTH_PORT=

# Pluggable providers
# SEARCH_PROVIDER: postgres | opensearch
SEARCH_PROVIDER=postgres
OPENSEARCH_URL=http://localhost:9200
# STORAGE_DRIVER: local | s3   (s3 covers AWS S3, Cloudflare R2 and MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=ats-gem-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Auth — JWT_SECRET is required everywhere (boot fails without it).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
# Opaque refresh tokens (hashed, rotated) live in the `sessions` table — there is no refresh JWT/secret.
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=atsgem_rt
# COOKIE_SECURE: unset = true in production, false otherwise (dev over plain HTTP)
COOKIE_SECURE=
# Login throttling (Redis sliding window per IP and per account; docs/ARCHITECTURE.md §5.3)
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_WINDOW_MINUTES=15
# Per-IP limit on register / forgot-password / reset-password (docs/API-CONTRACT.md §1.5)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
# Google OAuth: routes exist but return 422 CHANNEL_NOT_AVAILABLE until these are set (Phase 2 stub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Crawler credential encryption master key (later: Phase 5) — 32 bytes, base64
CREDENTIALS_MASTER_KEY=

# Email — EMAIL_DRIVER: log (Phase 1: records masked sends, delivers nothing) | smtp (Phase 2)
EMAIL_DRIVER=log
EMAIL_FROM="ATS Gem <no-reply@atsgem.example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Payments (later: Phase 8)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Observability (optional)
ERROR_TRACKING_DSN=
