backend/.data/

# Local Docker overrides (personal ports, mounts, credentials)
docker-compose.override.yml
compose.override.yml

# Test and browser-automation artifacts (Playwright crawler arrives in Phase 5)
test-results/
playwright-report/
blob-report/

# Tool caches and scratch space
.eslintcache
.cache/
tmp/
.tmp/

# Logs
logs/
*.log
npm-debug.log*
