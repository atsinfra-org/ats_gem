# Backend API base URL (see backend/.env.example PORT + API_PREFIX). The backend's
# CORS_ORIGINS must include this frontend's own origin (defaults to http://localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public site URL used for canonical links, sitemap and JSON-LD (lib/site.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
